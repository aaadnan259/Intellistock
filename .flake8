[flake8]
max-line-length = 88
extend-ignore = E203, W503
per-file-ignores =
    # Ignore unused imports in __init__.py files
    */__init__.py: F401
    # Ignore unused imports in admin.py and tests.py (common Django pattern)
    */admin.py: F401
    */tests.py: F401
exclude =
    .git,
    __pycache__,
    migrations,
    .venv,
    venv,
    build,
    dist
